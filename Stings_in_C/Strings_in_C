#include<stdio.h>
#define SIZE 60

int find_num_of_vowels(char *string, int size);
int main(void) {
    char sentence[SIZE] = "Great singer";
    int number_of_vowels = find_num_of_vowels(sentence, SIZE);
    printf("The number of vowels in: %d\n", number_of_vowels);
    return 0;
}

/*
---Analysis Table---
i | charcter | num_of_vowels | event |
0 | G        | 0             | continue
1 | r        | 0             | continue
2 | e        | 1             | vowel encounter
3 | a        | 2             | vowel encounter
4 | t        | 2             | continue
5 | s        | 2             | continue
6 | i        | 3             | vowel encounter
7 | n        | 3             | continue
8 | g        | 3             | continue
9 | e        | 4             | vowel encounter
10| r        | 4             | continue


variable | initial_state | update_condition | Update
i        | 0             | every iteration  | i++
character| -             | every iteration  | string[i]
num_of_..| 0             | string[i]=='a'...| numb_of_vowels++


*/

int find_num_of_vowels(char *string, int size) {
    int i = 0;
    char character;
    int num_of_vowels = 0;
    while(i < size) {
        if(string[i] == '\0') {
            break;
        }
        character = string[i];
        if (character == 'a' || character == 'i' || character == 'u' || character == 'o' || character == 'e'){
            num_of_vowels++;
        }
        i++;
    }
    return num_of_vowels;
}